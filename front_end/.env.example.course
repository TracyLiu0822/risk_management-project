# 环境变量配置示例
# 复制此文件为 .env.local，并根据需要修改

# === API 配置 ===

# 课程 API 端点（当前使用 mock 数据）
# NEXT_PUBLIC_COURSE_API_URL=https://api.example.com/api/courses

# 聊天 AI 端点（当前使用 mock 数据）
# NEXT_PUBLIC_CHAT_API_URL=https://api.example.com/api/chat

# === 认证配置 ===

# NextAuth 密钥
# NEXTAUTH_SECRET=your-secret-key-here
# NEXTAUTH_URL=http://localhost:3000

# === 功能开关 ===

# 启用 AI 聊天功能
NEXT_PUBLIC_ENABLE_CHAT=true

# 启用数据分析（Google Analytics 等）
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# === 日志配置 ===

# 开启详细日志模式（开发环境）
# NEXT_PUBLIC_DEBUG_MODE=true

# === 第三方服务 ===

# OpenAI API（如果使用 OpenAI 作为 AI 后端）
# OPENAI_API_KEY=your-openai-key

# 其他第三方 API 密钥...
