# Database (use async drivers)
# Development with SQLite:
DATABASE_URL=sqlite+aiosqlite:///./risk_management.db

# Production with Postgres (example):
# DATABASE_URL=postgresql+asyncpg://dbuser:dbpass@dbhost:5432/dbname

# App secrets
SECRET_KEY=replace-with-a-secure-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
TEACHER_REGISTRATION_CODE=replace-with-a-private-teacher-code
SERVE_FRONTEND=True
# FRONTEND_DIST_DIR=./front_end/out

# Optional external keys
OPENAI_API_KEY=

# Local course material directory (Markdown/text; PDF upload is converted to text)
# COURSE_MATERIAL_DIR=./docs/course_materials
# 环境变量示例
# 复制此文件为 .env 并根据实际情况修改

# ========================================
# 应用配置
# ========================================
ENVIRONMENT=development
PROJECT_NAME=Risk Management Platform
PROJECT_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# ========================================
# 服务器配置
# ========================================
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]

# ========================================
# 数据库配置
# ========================================
# SQLite (开发环境)
DATABASE_URL=sqlite:///./risk_management.db

# PostgreSQL (生产环境) - 取消注释并配置
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/risk_management

DATABASE_ECHO=False

# ========================================
# 认证配置
# ========================================
SECRET_KEY=your-secret-key-change-in-production-12345678
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# OpenAI 配置
# ========================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# ========================================
# RAG 配置
# ========================================
RAG_ENABLED=True
VECTOR_STORE_TYPE=chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ========================================
# 文件上传配置
# ========================================
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=["pdf","txt","md"]

# ========================================
# 前端配置（仅用于参考，前端使用 .env.local）
# ========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Risk Management Platform
NEXT_PUBLIC_APP_VERSION=1.0.0
