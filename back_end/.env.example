# Application
HOST=0.0.0.0
PORT=8000
DEBUG=True
SERVE_FRONTEND=True
# FRONTEND_DIST_DIR=../front_end/out

# Database
DATABASE_URL=sqlite+aiosqlite:///./risk_management.db
DATABASE_ECHO=False

# Authentication
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TEACHER_REGISTRATION_CODE=replace-with-a-private-teacher-code

# Optional LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=800

# Local RAG
# COURSE_MATERIAL_DIR=../docs/course_materials
RAG_TOP_K=5
RAG_MIN_SCORE=0.05
